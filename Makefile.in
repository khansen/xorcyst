	tags tags-am uninstall uninstall-am uninstall-binPROGRAMS \
	uninstall-dist_docDATA uninstall-man uninstall-man1 \
	uninstall-nobase_dist_docDATA

.PRECIOUS: Makefile


# Use the build-tree tools even when distcheck builds outside the source tree.
check-local:
	PYTHONDONTWRITEBYTECODE=1 XASM="$(abs_builddir)/xasm" XLNK="$(abs_builddir)/xlnk" \
	  $(SHELL) "$(srcdir)/tests/regression.sh"

installcheck-local:
	python3 "$(srcdir)/tests/test_installation.py" "$(DESTDIR)$(bindir)" "$(DESTDIR)$(docdir)" "$(DESTDIR)$(mandir)/man1"

# Optional maintainer-only regeneration rules
# (These are only used if someone runs make after editing parser.y/scanner.l)

# Regenerate both parser.c and parser.h from parser.y
@MAINTAINER_MODE_TRUE@parser.c parser.h: parser.y
@MAINTAINER_MODE_TRUE@	@if test "x$(YACC)" = "x:"; then \
@MAINTAINER_MODE_TRUE@	  echo "Cannot regenerate parser.c/parser.h: no yacc/bison/byacc found (YACC is ':')"; \
@MAINTAINER_MODE_TRUE@	  exit 1; \
@MAINTAINER_MODE_TRUE@	fi
@MAINTAINER_MODE_TRUE@	$(AM_V_YACC)$(YACC) $(AM_YFLAGS) -d -o parser.c $<

@MAINTAINER_MODE_TRUE@scanner.c: scanner.l
@MAINTAINER_MODE_TRUE@	@if test "x$(LEX)" = "x:"; then \
@MAINTAINER_MODE_TRUE@	  echo "Cannot regenerate scanner.c: no flex/lex found (LEX is ':')"; \
@MAINTAINER_MODE_TRUE@	  exit 1; \
@MAINTAINER_MODE_TRUE@	fi
@MAINTAINER_MODE_TRUE@	$(AM_V_LEX)$(LEX) $(AM_LFLAGS) -o $@ $<

# Regenerate the man pages from --help/--version output of the just-built
# tools, plus the SEE ALSO/COPYRIGHT material in man1/*.h2m.
@MAINTAINER_MODE_TRUE@man1/xasm.1: xasm$(EXEEXT) $(srcdir)/man1/xasm.h2m
@MAINTAINER_MODE_TRUE@	@if test "x$(HELP2MAN)" = "x:"; then \
@MAINTAINER_MODE_TRUE@	  echo "Cannot regenerate man1/xasm.1: no help2man found (HELP2MAN is ':')"; \
@MAINTAINER_MODE_TRUE@	  exit 1; \
@MAINTAINER_MODE_TRUE@	fi
@MAINTAINER_MODE_TRUE@	$(AM_V_GEN)$(MKDIR_P) man1 && \
@MAINTAINER_MODE_TRUE@	  $(HELP2MAN) --no-info --section=1 --manual="XORcyst Manual" \
@MAINTAINER_MODE_TRUE@	    --name="assembler for 6502 machine code" \
@MAINTAINER_MODE_TRUE@	    --include=$(srcdir)/man1/xasm.h2m \
@MAINTAINER_MODE_TRUE@	    --output=$@ ./xasm$(EXEEXT)

@MAINTAINER_MODE_TRUE@man1/xlnk.1: xlnk$(EXEEXT) $(srcdir)/man1/xlnk.h2m
@MAINTAINER_MODE_TRUE@	@if test "x$(HELP2MAN)" = "x:"; then \
@MAINTAINER_MODE_TRUE@	  echo "Cannot regenerate man1/xlnk.1: no help2man found (HELP2MAN is ':')"; \
@MAINTAINER_MODE_TRUE@	  exit 1; \
@MAINTAINER_MODE_TRUE@	fi
@MAINTAINER_MODE_TRUE@	$(AM_V_GEN)$(MKDIR_P) man1 && \
@MAINTAINER_MODE_TRUE@	  $(HELP2MAN) --no-info --section=1 --manual="XORcyst Manual" \
@MAINTAINER_MODE_TRUE@	    --name="linker for xasm object files" \
@MAINTAINER_MODE_TRUE@	    --include=$(srcdir)/man1/xlnk.h2m \
@MAINTAINER_MODE_TRUE@	    --output=$@ ./xlnk$(EXEEXT)

# Tell versions [3.59,3.63) of GNU make to not export all variables.
# Otherwise a system limit (for SysV at least) may be exceeded.
.NOEXPORT:

# Tell GNU make to disable its built-in pattern rules.
%:: %,v
%:: RCS/%,v
%:: RCS/%
%:: s.%
%:: SCCS/s.%
