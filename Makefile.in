	$(AM_V_CCLD)$(LINK) $(xlnk_OBJECTS) $(xlnk_LDADD) $(LIBS)
v2/linker.$(OBJEXT): v2/$(am__dirstamp) v2/$(DEPDIR)/$(am__dirstamp)
v2/link.$(OBJEXT): v2/$(am__dirstamp) v2/$(DEPDIR)/$(am__dirstamp)
v2/object.$(OBJEXT): v2/$(am__dirstamp) v2/$(DEPDIR)/$(am__dirstamp)
v2/value.$(OBJEXT): v2/$(am__dirstamp) v2/$(DEPDIR)/$(am__dirstamp)
v2/heap.$(OBJEXT): v2/$(am__dirstamp) v2/$(DEPDIR)/$(am__dirstamp)
v2/layout.$(OBJEXT): v2/$(am__dirstamp) v2/$(DEPDIR)/$(am__dirstamp)

xlnk-v2$(EXEEXT): $(xlnk_v2_OBJECTS) $(xlnk_v2_DEPENDENCIES) $(EXTRA_xlnk_v2_DEPENDENCIES)
	@rm -f xlnk-v2$(EXEEXT)
	$(AM_V_CCLD)$(LINK) $(xlnk_v2_OBJECTS) $(xlnk_v2_LDADD) $(LIBS)

mostlyclean-compile:
	-rm -f *.$(OBJEXT)
	-rm -f v2/*.$(OBJEXT)

distclean-compile:
	-rm -f *.tab.c

