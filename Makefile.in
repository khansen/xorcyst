    find "$(distdir)" -type d ! -perm -700 -exec chmod u+rwx {} ';' \
      ; rm -rf "$(distdir)" \
      || { sleep 5 && rm -rf "$(distdir)"; }; \
  else :; fi
am__post_remove_distdir = \
  $(am__is_gnu_make) || rm -f am__distdir.tar; \
  $(am__remove_distdir)
